# 复制为 .env 后填写。至少配一个模型的 key。

## 默认使用哪个模型
AGENT_PROVIDER=deepseek

## 模型密钥（按需填写）
DEEPSEEK_API_KEY=
GLM_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_API_KEY=            # 本地 Ollama 可留空

## 可选：覆盖接口地址（例如走公司代理 / 私有网关）
# DEEPSEEK_BASE_URL=https://your-gateway/v1
# GLM_BASE_URL=https://your-gateway/api/paas/v4

## 搜索后端（三选一，都不配则用 DuckDuckGo）
# TAVILY_API_KEY=            # https://tavily.com  免费额度足够开发
# BING_SEARCH_API_KEY=       # Azure Bing Web Search v7
# SEARXNG_URL=http://localhost:8080
